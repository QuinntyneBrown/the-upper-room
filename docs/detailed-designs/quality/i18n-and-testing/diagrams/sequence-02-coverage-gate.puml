@startuml
title UML sequence behaviour — Coverage gate
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Developer" as actor
box "Build — CI pipeline" #F2F4F7
  participant "CI job" as ci
  participant "dotnet test" as dn
  participant "coverlet.runsettings" as cfg
end box
actor -> ci : Open pull request
ci -> dn : dotnet test --collect "XPlat Code Coverage"
dn -> cfg : Read thresholds
dn -> dn : Measure Domain, Application, Infrastructure (L2-101)
alt any layer below threshold
  dn --> ci : Non-zero exit
  ci --> actor : Fail, for example Application below 85%
else all layers meet thresholds
  dn --> ci : Exit 0
  ci --> actor : Pass
end
@enduml
