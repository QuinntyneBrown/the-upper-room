@startuml
title UML sequence behaviour — Announce a snackbar
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Screen-reader member" as actor
box "Frontend — the-upper-room application" #E0F2FE
  participant "Page" as page
  participant "SnackbarService" as svc
  participant "tar-snackbar" as sn
  participant "Screen reader" as sr
end box
page -> svc : show(message, severity)
svc -> sn : current signal updates
alt severity is info or success
  sn -> sn : Render role="status" (L2-086)
  sn -> sr : Polite announcement
else severity is warning or error
  sn -> sn : Render role="alert" (L2-086)
  sn -> sr : Assertive announcement
end
sr --> actor : Message read
@enduml
