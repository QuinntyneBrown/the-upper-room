@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Configure kanban
Person(member, "Member or authorized administrator")
System_Boundary(room, "The Upper Room") {
Container(spa, "Upper Room browser app", "Angular", "BoardConfigure, MoveCardsDialog, IBoardsApi")
Container(api, "Upper Room API", "ASP.NET Core", "BoardsController, Board configuration handlers")
ContainerDb(data, "Upper Room database", "KanbanDbContext", "Boards, columns, cards")
}
Rel(member, spa, "Uses")
Rel(spa, api, "Calls feature boundary", "JSON over HTTPS")
Rel(api, data, "Reads or persists authorized state", "Application interfaces")
@enduml
