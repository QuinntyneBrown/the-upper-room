@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam maxMessageSize 80
title Target behavior - Browse and filter ideas
actor "Member" as actor
box "Frontend - Upper Room application" #E0F2FE
participant "IdeaList" as page
end box
box "Backend - Upper Room API application" #D1FADF
participant "IdeasController" as ctrl
end box
box "Backend - Application and Domain" #ECFDF3
participant "IIdeasDbContext" as ctx
end box
box "Backend - Infrastructure" #FFF4E5
database "IdeasDbContext" as db
end box
actor -> page : Open /ideas
page -> ctrl : GET /api/v1/ideas with filters and sort
ctrl -> ctrl : Authenticate and resolve city scope
ctrl -> ctx : Query ideas
ctx -> db : Read ideas, votes, partners
db --> ctx : Rows
ctx --> ctrl : Ideas
alt request fails
ctrl --> page : Error response
page --> actor : Keep previous grid and show feedback
else success
ctrl --> page : IdeaDto list
page -> page : Apply L2-049 grid, chips, and sort
page --> actor : Responsive card grid
end
@enduml
