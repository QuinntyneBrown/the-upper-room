@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 80
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Target behavior - Share native link
actor "Member or authorized administrator" as actor
box "Frontend - Upper Room application and libraries" #E0F2FE
participant "TarShareButton" as page
participant "ContactDetail" as client
end box
actor -> page : Share native link
page -> client : Invoke supported browser share capability
client -> client : Apply L2-118 and relevant feature rules
alt supported and successful
client --> page : Report completion or cancellation
else invalid, unavailable, or failed
client --> page : Preserve prior state or explicit fallback
end
page --> actor : Accessible result or recovery
@enduml
