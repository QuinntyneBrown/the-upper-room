@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 80
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Target behavior - Authorize resource request
actor "Member or authorized administrator" as actor
box "Frontend - Upper Room application and libraries" #E0F2FE
participant "PermissionsService" as page
participant "HasRoleDirective" as client
end box
box "Backend - Upper Room API application" #D1FADF
participant "Proposed feature HTTP boundary" as boundary
end box
box "Backend - Application and Domain" #ECFDF3
participant "Proposed Enforce permissions application service" as logic
end box
box "Backend - Infrastructure" #FFF4E5
database "Feature state / adapter (target role)" as state
end box
actor -> page : Authorize resource request
page -> client : Evaluate policy and city scope before accessing data
client -> boundary : Authorized feature request
boundary -> boundary : Authenticate and validate request shape
alt invalid or forbidden request
boundary --> client : Safe error and correlation identifier
client --> page : Preserve input or previous state
else accepted request
boundary -> logic : Dispatch target operation
logic -> logic : Apply L2-024 and referenced feature rules
logic -> state : Read or persist authorized feature state
state --> logic : State or dependency result
alt rule or dependency failure
logic --> boundary : Rejected feature outcome
boundary --> client : Mapped failure response
client --> page : Retain or restore prior state
else success
logic --> boundary : Allow scoped operation or return denial
boundary --> client : Typed response
client --> page : Updated feature state
end
end
page --> actor : Result or recoverable feedback
@enduml
