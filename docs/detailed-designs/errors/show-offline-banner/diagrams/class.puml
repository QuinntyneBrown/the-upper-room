@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Show offline banner

enum BannerState {
  offline
  online
  null
}

class NetworkService {
  -signal offline: boolean
  -signal justRecovered: boolean
  -signal dismissed: boolean
  +computed bannerState: BannerState
  +dismiss(): void
}

class OfflineBanner {
  #NetworkService svc
  #string offlineMessage
  #string onlineMessage
}

class TarBanner {
  +string message
  +TarBannerSeverity severity
  +string icon
  +boolean dismissible
  +dismissed: EventEmitter
}

NetworkService --> BannerState
OfflineBanner ..> NetworkService : injects
OfflineBanner ..> TarBanner : renders
@enduml
