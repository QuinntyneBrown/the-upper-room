@startuml
title UML sequence behaviour — Secret resolution
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Operator" as actor
box "Backend — TheUpperRoom.Api application" #D1FADF
  participant "Program.cs" as prog
  participant "IConfiguration" as conf
end box
box "Backend — TheUpperRoom Infrastructure" #FFF4E5
  participant "Key vault" as kv
end box
actor -> prog : Start API
prog -> conf : Read Jwt:SigningKey and Push:VapidPublicKey
conf -> kv : Resolve in Production <TO SUPPLY>
kv --> conf : Secret values
conf --> prog : Settings
alt value missing and environment is Production
  prog --> actor : Throw InvalidOperationException (L2-095)
else value missing in Development
  prog -> prog : Use dev-only placeholder
else value present
  prog -> prog : Register settings; never log values (L2-095)
end
@enduml
