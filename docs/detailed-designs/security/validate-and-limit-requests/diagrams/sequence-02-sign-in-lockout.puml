@startuml
title UML sequence behaviour — Sign-in lockout
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Client" as actor
box "Backend — TheUpperRoom.Api application" #D1FADF
  participant "AuthController" as ctrl
  participant "AuthRateLimiter" as rl
end box
box "Backend — TheUpperRoom Infrastructure" #FFF4E5
  database "Distributed cache" as cache
end box
actor -> ctrl : POST sign-in
ctrl -> rl : IsSignInLockedAsync(email)
rl -> cache : Get bucket
cache --> rl : Bucket
alt locked
  rl --> ctrl : true
  ctrl --> actor : 429, Retry-After: 1800 (L2-094)
else not locked
  rl --> ctrl : false
  ctrl -> ctrl : Verify credentials
  alt credentials wrong
    ctrl -> rl : RecordFailedSignInAsync(email)
    rl -> cache : Increment within 15 minute window
    opt count exceeds 5
      rl -> cache : Set LockUntil (30 minutes)
      rl --> ctrl : locked
      ctrl --> actor : 429, Retry-After: 1800
    end
    ctrl --> actor : 401
  else credentials valid
    ctrl --> actor : 200
  end
end
@enduml
