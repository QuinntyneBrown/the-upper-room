@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Manage notes
Person(member, "Member or authorized administrator")
System_Boundary(room, "The Upper Room") {
Container(spa, "Upper Room browser app", "Angular", "TarNotes, NoteHistoryDialog, INotesApi")
Container(api, "Upper Room API", "ASP.NET Core", "NotesController, CreateNoteHandler")
ContainerDb(data, "Upper Room database", "NotesDbContext", "Notes and versions")
}
Rel(member, spa, "Uses")
Rel(spa, api, "Calls feature boundary", "JSON over HTTPS")
Rel(api, data, "Reads or persists authorized state", "Application interfaces")
@enduml
