@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 80
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Target behavior - Delete note
actor "Author or administrator" as actor
box "Frontend - Upper Room application and libraries" #E0F2FE
participant "TarNotes" as page
participant "INotesApi" as client
end box
box "Backend - Upper Room API application" #D1FADF
participant "NotesController" as boundary
end box
box "Backend - Application and Domain" #ECFDF3
participant "DeleteNoteHandler" as logic
end box
box "Backend - Infrastructure" #FFF4E5
database "NotesDbContext" as state
end box
actor -> page : Delete note
page -> client : DELETE /api/v1/notes/{id} after confirmation
client -> boundary : Authorized feature request
boundary -> boundary : Authenticate and validate request shape
alt invalid or forbidden request
boundary --> client : Safe error and correlation identifier
client --> page : Preserve input or previous state
else accepted request
boundary -> logic : Dispatch operation
logic -> logic : Apply L2-042 rule that only the author or an administrator deletes
logic -> state : Read or persist authorized state
state --> logic : State or dependency result
alt rule or dependency failure
logic --> boundary : Rejected outcome
boundary --> client : Mapped failure response
client --> page : 403 or recoverable failure; note retained
else success
logic --> boundary : Outcome
boundary --> client : Typed response
client --> page : Note removed from the list
end
end
page --> actor : Result or recoverable feedback
@enduml
