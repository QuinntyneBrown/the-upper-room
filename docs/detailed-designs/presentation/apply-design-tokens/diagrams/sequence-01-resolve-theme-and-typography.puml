@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 80
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Target behavior - Resolve theme and typography
actor "Member or authorized administrator" as actor
box "Frontend - Upper Room application and libraries" #E0F2FE
participant "TarIcon" as page
participant "ThemeService" as client
end box
actor -> page : Resolve theme and typography
page -> client : Resolve the requested color roles and type scale
client -> client : Apply L2-001 and relevant feature rules
alt supported and successful
client --> page : Render readable controls
else invalid, unavailable, or failed
client --> page : Preserve prior state or explicit fallback
end
page --> actor : Accessible result or recovery
@enduml
