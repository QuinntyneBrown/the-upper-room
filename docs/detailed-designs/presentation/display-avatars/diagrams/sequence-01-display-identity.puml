@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 80
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Target behavior - Display identity
actor "Member or authorized administrator" as actor
box "Frontend - Upper Room application and libraries" #E0F2FE
participant "TarAvatar" as page
participant "TarAvatarUploader" as client
end box
actor -> page : Display identity
page -> client : Select image or deterministic initials
client -> client : Apply L2-106 and relevant feature rules
alt supported and successful
client --> page : Render a circular avatar
else invalid, unavailable, or failed
client --> page : Preserve prior state or explicit fallback
end
page --> actor : Accessible result or recovery
@enduml
