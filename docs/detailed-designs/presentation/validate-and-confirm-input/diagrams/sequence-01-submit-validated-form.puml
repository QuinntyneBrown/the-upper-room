@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam sequenceMessageAlign center
skinparam maxMessageSize 80
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Target behavior - Submit validated form
actor "Member or authorized administrator" as actor
box "Frontend - Upper Room application and libraries" #E0F2FE
participant "TarTextField" as page
participant "ConfirmOptions" as client
end box
actor -> page : Submit validated form
page -> client : Validate fields and prevent duplicate submission
client -> client : Apply L2-071 and relevant feature rules
alt supported and successful
client --> page : Show saving or field errors
else invalid, unavailable, or failed
client --> page : Preserve prior state or explicit fallback
end
page --> actor : Accessible result or recovery
@enduml
