@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Archive or delete contact
Person(member, "Member or authorized administrator")
System_Boundary(room, "The Upper Room") {
Container(spa, "Upper Room browser app", "Angular", "ContactDetail, ContactPhone, ConfirmOptions")
Container(api, "Upper Room API", "ASP.NET Core", "ContactsController")
ContainerDb(data, "Feature persistence (target)", "Infrastructure adapters", "Authorized feature state; provider gaps are described in the design")
}
Rel(member, spa, "Uses")
Rel(spa, api, "Calls feature boundary", "JSON or multipart over HTTPS")
Rel(api, data, "Reads or persists authorized state", "Application interfaces")
@enduml
